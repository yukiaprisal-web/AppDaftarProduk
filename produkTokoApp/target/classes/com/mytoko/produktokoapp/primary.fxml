<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="757.0" prefWidth="383.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mytoko.produktokoapp.PrimaryController">
   <children>
      <VBox prefHeight="58.0" prefWidth="343.0">
         <children>
            <Label alignment="TOP_LEFT" text="Produk Toko" textAlignment="CENTER">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <Label text="Sistem Manajemen Produk" />
         </children>
      </VBox>
      <VBox prefHeight="200.0" prefWidth="100.0">
         <children>
            <Label text="Kode Produk" />
            <TextField fx:id="txtKode" />
            <Label text="Nama Produk" />
            <TextField fx:id="txtNama" />
            <Label text="Kategori" />
            <ComboBox fx:id="cbKategori" prefWidth="150.0" />
            <Label text="Harga" />
            <TextField fx:id="txtHarga" />
         </children>
      </VBox>
      <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0">
         <children>
            <Button fx:id="primaryButton" onAction="#handleSimpan" prefHeight="47.0" prefWidth="277.0" text="Simpan Produk" />
            <Button fx:id="primaryButton1" onAction="#handleLihat" prefHeight="47.0" prefWidth="278.0" text="LIhat daftar Produk" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
